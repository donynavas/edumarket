# Educación Plus — Apache Configuration
Options -Indexes

# Allow rewrite
RewriteEngine On

# Security: protect sensitive files
<FilesMatch "\.(env|log|sql|sh|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP error display (disable in production)
<IfModule mod_php.c>
    php_flag display_errors On
    php_flag log_errors On
    php_value error_log logs/php_error.log
    php_value session.cookie_httponly 1
</IfModule>

# Compress
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
